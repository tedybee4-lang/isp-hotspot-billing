# =============================================================================
#  ISPFlow — FreeRADIUS `post-auth` policy (session opening).
#
#  ⚠ INLINED into the site's `post-auth { }` section by install-vps.sh. See the
#  header of the `authorize` file for why inlining is required and what every
#  other mechanism does instead.
#
#  Runs after a successful authentication and turns a login into a usable,
#  billable session:
#
#    1. Opens an accounting session in ISPFlow (acct_session_id, start time,
#       framed address, called station, NAS) so the panel can show who is online
#       and for how long.
#    2. Records which router accepted the login, so an operator can tell which
#       site a customer is connected through.
#
#  Idempotent on acct_session_id, so a router that re-sends Acct-Start on a link
#  flap updates one row instead of creating a second session.
#
#  ── Deliberately NOT done here ───────────────────────────────────────────────
#  * Deactivation. An acct_stop written in this module would cut every live
#    customer whenever FreeRADIUS restarted or lost its database. Sessions are
#    closed by the router's Acct-Stop and by the worker for a deliberate
#    disconnect. A RADIUS restart must not be an outage.
#  * Rewriting the rate limit. MikroTik has already applied it by the time
#    post-auth runs; changing it would have no effect and would make the log
#    disagree with the router.
# =============================================================================

update control {
    &NETISP::SessionStart := "%{Acct-Session-Id}"
}

# HotSpot and PPPoE both send an Acct-Session-Id, but HotSpot's can be empty on
# some firmware. The fallback is composed from attributes already present, never
# from a timestamp alone, so a retry of the same login reuses the same id and the
# query's ON CONFLICT folds it into one row rather than double-counting the
# customer's online time.
if ("%{NETISP::SessionStart}" == "") {
    update control {
        &NETISP::SessionStart := "%{User-Name}-%{Called-Station-Id}-%{Framed-IP-Address}"
    }
}

# The query derives isp_id from radius_nas by Called-Station-Id and joins the
# subscriber inside that tenant, so an unregistered router inserts nothing and a
# second ISP's identically-named customer can never be opened by the wrong router.
sql_query("%{sql_escape:%{NETISP::SessionStart}}", "ISPFlow/PostAuth/OpenSession")

# A failure here must NOT reject a customer who has already authenticated. The
# router has admitted them; refusing now would cut a paying customer off because
# of a bookkeeping problem. Log it and continue — the next Interim-Update
# reopens the row through the accounting policy, and the panel shows the session
# as soon as that lands.
if (!ok) {
    radius_log("NETISP: could not open session %{NETISP::SessionStart} for %{User-Name} from %{Called-Station-Id}")
}