# =============================================================================
#  ISPFlow — FreeRADIUS `authorize` policy.
#
#  ⚠ THIS FILE IS INLINED INTO THE SITE, NOT LOADED AS A MODULE.
#
#  install-vps.sh splices this text directly into the `authorize { }` section of
#  sites-available/default. That is not a stylistic choice. FreeRADIUS 3.2.5
#  rejects a top-level `if` in every other context, each verified on the host:
#
#     mods-enabled/netisp-authorize -> "Invalid location for 'if'"
#     policy.d/netisp-authorize     -> "Invalid location for 'if'"
#     $INCLUDE sites-available/...  -> "Invalid location for 'if'"
#
#  A module file is instantiated, a policy.d file and an $INCLUDEd file are each
#  parsed as a standalone unit; none of them is a site section, and `if` is only
#  valid inside one. Inlining is the supported way to add custom unlang.
#
#  It answers, for a MikroTik router asking whether a device may come online:
#
#    1. Which tenant does this packet belong to?
#    2. May this subscriber in?
#    3. At what speed, with what session limit, until when?
#
#  All three come from ISPFlow's own tables, so a payment, a suspension or a
#  package change takes effect on the next authentication with nobody touching
#  the router.
#
#  ── Tenant resolution ────────────────────────────────────────────────────────
#  The router is identified by Called-Station-Id and resolved against radius_nas
#  in the SQL query. An unregistered router yields no row, so the request is
#  rejected before any subscriber is considered. That is the isolation boundary:
#  the router's identity, not the username, decides whose customers are in play.
#
#  ── Username normalisation ──────────────────────────────────────────────────
#  HotSpot presents "user@radius" (the realm identifies the router, not the
#  subscriber); PPPoE presents the bare username. Both normalise to one key.
#  Anything matching neither shape is rejected BEFORE any database call.
#
#  ── Data sources ────────────────────────────────────────────────────────────
#    radius_nas        the router -> tenant trust anchor
#    service_accounts  the login credential, its status and its expiry
#    radius_accounts   simultaneous-device limit
#    plans             the package and its speeds
# =============================================================================

update control {
    # Capped well below FreeRADIUS's default so a hostile username cannot
    # become an expensive query.
    &NETISP-LookupKey := "%{User-Name}"
    # rlm_sql's authorize_check_query returns a column named 'User-Name' and
    # compares it against the CONTROL list. User-Name arrives in the REQUEST
    # list, so without this the comparison is against an attribute that is not
    # there, the row is discarded as a mismatch, and the module returns `fail`:
    #     } # authorize = fail
    # for a subscriber that exists and would otherwise authenticate.
    &User-Name := "%{User-Name}"
    &NETISP-LookupKey := "%{User-Name}"
}

# HotSpot realm stripping. Kept before the character filter so "user@radius"
# becomes "user" and the filter below sees a clean value.
if ("%{control:NETISP-LookupKey}" =~ /^(.+)@[A-Za-z0-9.-]+$/) {
    update control {
        &NETISP-LookupKey := "%{1}"
    }
}

# Reject anything that is not a plausible subscriber name before touching the
# database. HotSpot allows arbitrary characters in the login field, so this is
# the only place they are filtered. A permissive LIKE here would let a crafted
# username read another subscriber's rate limit.
#
# NB the character class is NOT written with a {1,64} quantifier. FreeRADIUS
# unlang parses `{` as the start of a section, so `/^[A-Za-z0-9._-]{1,64}$/`
# silently opens a block and the closing `}` terminates the enclosing
# `authorize` section early. The symptom is a parse error far below this line,
# on the next statement: "Parse error after sql_load_accounts: unexpected
# token '('". Length is therefore bounded with a separate comparison.
if (!"%{control:NETISP-LookupKey}" =~ /^[A-Za-z0-9._-]+$/) {
    update control {
        &Auth-Type := Reject
        &Reply-Message := "NETISP: malformed username"
    }
    reject
}

if (("%{control:NETISP-LookupKey}" =~ /^................................................................./)) {
    update control {
        &Auth-Type := Reject
        &Reply-Message := "NETISP: username too long"
    }
    reject
}

# An unregistered router is rejected here. The query joins radius_nas, so an
# unknown Called-Station-Id returns nothing and `ok` is false.
if ("%{Called-Station-Id}" == "") {
    update control {
        &Auth-Type := Reject
        &Reply-Message := "NETISP: no NAS identity"
    }
    reject
}
# rlm_sql has no sql_query() function. In FreeRADIUS 3 the queries are bound to
# the section they belong to, so invoking the module IS the call: it runs
# authorize_check_query and, when that matched, authorize_reply_query, which
# lands Cleartext-Password and the MikroTik-* attributes in the reply list.
#
# The previous code called sql_query("ISPFlow/Authorize/LoadAccount") and then
# branched on %{NETISP::Loaded}. Neither existed. rlm_sql registers no policy
# functions at all (`strings rlm_sql.so | grep ^sql_` returns nothing), so the
# call could only ever fail to parse, and NETISP::Loaded was never declared in
# the dictionary nor ever set, so a successful lookup would have been rejected as
# a failure anyway.
#
# The tenant gate is NOT here and must not be added here. It is in the SQL, which
# joins radius_nas before service_accounts, so it cannot return a row for a
# router that is not registered or for a subscriber belonging to another tenant.
# Calling `sql` is therefore already tenant-safe: no username-only path is left.
sql

# rlm_sql sets Auth-Type := Accept only when authorize_check_query returned a
# row. No row means no such subscriber on this router, which covers both "this
# customer does not exist" and "this customer belongs to a different ISP"
# without telling the caller which. That indistinguishability is deliberate: it
# is what stops a router being used to probe for another tenant's customers.
#
# It is also the most common failure for a new customer whose provisioning job
# has not run yet, so the message says exactly that.
# Reply-Message, not Auth-Error.
#
# Auth-Error is not defined anywhere in this FreeRADIUS 3.2.5 installation:
#
#     sites-enabled/default[360]: Unknown attribute 'Auth-Error'
#
# Reply-Message (RFC 2865) always is, and it is what MikroTik actually shows
# the customer on HotSpot, which is the behaviour these messages were written for.
if (!&control:Auth-Type) {
    update control {
        &Auth-Type := Reject
        &Reply-Message := "NETISP: no active service account for this username on this router"
    }
    reject
}

# Cleartext-Password arrives in the REPLY list because authorize_reply_query
# returns it there. It is copied into control explicitly rather than relying on
# the stock site's pap/chap/mschap sections to find it, because that reliance
# worked until an unrelated site edit moved the assignment.
#
# It is never written to a reply attribute and never logged: radiusd.conf sets
# auth, badpass and goodpass to no.
if (&reply:Cleartext-Password) {
    update control {
        &Cleartext-Password := "%{reply:Cleartext-Password}"
    }
}

# Force the PAP comparison to actually run.
#
# The check query sets Auth-Type := Accept, which sends the request down the
# stock "Accept" path. That path does NOT verify the password before answering,
# so a WRONG PASSWORD was being ACCEPTED:
#     2. WRONG PASSWORD on the correct tenant   Access-Accept   FAIL
#
# Naming the type explicitly means the pap module runs and compares
# request:User-Password against control:Cleartext-Password. An unknown or empty
# stored password falls through to the reject below rather than through the door.
update control {
    &Auth-Type := PAP
}

# A subscriber with no provisioned password must never be admitted. Letting an
# empty password through would be an authentication bypass, not a failure.
if (!&control:Cleartext-Password) {
    update control {
        &Auth-Type := Reject
        &Reply-Message := "NETISP: account has no password provisioned"
    }
    reject
}

# Status and expiry are gated in authorize_check_query, in the same WHERE clause
# as the tenant resolution, so they are enforced in the database against the row
# that was actually matched rather than against a value carried back separately
# and possibly re-read. A suspended, pending or expired account returns no row
# and takes the reject branch above.
#
# Reply attributes (Mikrotik-Rate-Limit, Mikrotik-Simultaneous-Limit,
# Mikrotik-Expires, Service-Type) are returned by authorize_reply_query and are
# not copied out of the control list here: they were never in it.
