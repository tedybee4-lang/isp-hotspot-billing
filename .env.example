# Safaricom Daraja API Credentials
# Get these from https://developer.safaricom.co.ke

VITE_DARAJA_CONSUMER_KEY=your_consumer_key_here
VITE_DARAJA_CONSUMER_SECRET=your_consumer_secret_here
VITE_DARAJA_PASSKEY=your_passkey_here
VITE_DARAJA_SHORTCODE=174379
VITE_DARAJA_CALLBACK_URL=https://yourdomain.com/api/mpesa/callback

# Set to 'sandbox' for testing, 'production' for live payments
VITE_DARAJA_ENVIRONMENT=sandbox
