# ─────────────────────────────────────────────────────────────────────────────
#  ISPFlow — environment configuration
# ─────────────────────────────────────────────────────────────────────────────
#  Copy this file to `.env.local` and fill in the values.
#  With NO values set the app boots in DEMO MODE: every screen works, data
#  lives in localStorage, and no backend is required. Perfect for testing.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (Project Settings → API) ────────────────────────────────────────
# Leaving these blank keeps the app in demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ── Platform branding ────────────────────────────────────────────────────────
VITE_APP_NAME=ISPFlow
VITE_APP_URL=https://isp-hotspot-billing-mhapfxdsa-malariachrome-7756s-projects.vercel.app

# Optional direct API override. Leave blank to use the Vercel same-origin HTTPS
# rewrite in production; local dev defaults to the API at localhost:8000.
# Never configure localhost/private IP in Vercel.
VITE_API_URL=
# WebSockets connect directly over TLS, bypassing the HTTP rewrite.
VITE_WS_URL=wss://ispbillingapi.codevertexafrica.com

# ── Super admin bootstrap ────────────────────────────────────────────────────
# Comma-separated emails promoted to `super_admin` on signup by the
# handle_new_user() trigger. Add your operator email(s) here.
VITE_SUPER_ADMIN_EMAILS=

# VPS provisioning backend (used only by docker-compose --profile backend).
# VITE_APP_URL must be the exact Vercel production origin, e.g.
# https://isp-hotspot-billing-mhapfxdsa-malariachrome-7756s-projects.vercel.app
# BACKEND_URL must be the public HTTPS API origin.
BACKEND_URL=https://ispbillingapi.codevertexafrica.com
POSTGRES_PASSWORD=
POSTGRES_DB=ispbilling
POSTGRES_PORT=5432
BACKEND_PORT=8000
SECRET_KEY=
ENCRYPTION_KEY=
GLOBAL_ADMIN_EMAIL=
GLOBAL_ADMIN_PASSWORD=

# ─────────────────────────────────────────────────────────────────────────────
#  M-Pesa (Safaricom Daraja) credentials
# ─────────────────────────────────────────────────────────────────────────────
#  ⚠️  DO NOT put these in this file or any VITE_* variable.
#       Vite inlines VITE_* values into the public JavaScript bundle.
#       Daraja credentials belong in the `isp_payment_configs` table
#       (managed from the Super Admin panel) and are read server-side by
#       supabase/functions/stk-push. See DEPLOYMENT.md.
#
#  These are listed here ONLY as a reminder of what you need per ISP:
#    mpesa_consumer_key      → Daraja portal
#    mpesa_consumer_secret   → Daraja portal
#    mpesa_passkey           → Lipa na M-Pesa Online
#    mpesa_shortcode         → Paybill / Till number
# ─────────────────────────────────────────────────────────────────────────────
