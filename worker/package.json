{
  "name": "netisp-network-worker",
  "version": "1.0.0",
  "private": true,
  "description": "Persistent network worker: RouterOS API sessions, heartbeats, job queue.",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "start": "npm run build && node dist/index.cjs",
    "build": "esbuild src/index.ts --bundle --platform=node --format=cjs --target=node20 --outfile=dist/index.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2"
  },
  "devDependencies": {
    "@types/node": "22.19.17",
    "esbuild": "^0.25.0",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}