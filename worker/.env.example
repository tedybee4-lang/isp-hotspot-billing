# =============================================================================
#  NETISP Network Worker — production environment template.
#
#  Copy to /etc/netisp-worker/environment on the VPS and fill in real values:
#
#      sudo install -d -m 750 -o root -g root /etc/netisp-worker
#      sudo cp .env.example /etc/netisp-worker/environment
#      sudo chmod 640 /etc/netisp-worker/environment
#      sudo chown root:netisp-worker /etc/netisp-worker/environment
#      sudoedit /etc/netisp-worker/environment
#
#  That file is mode 640 and group-owned by the service account, so the worker
#  can read it and nobody else can. Never commit a filled-in copy of this file.
# =============================================================================

# ── Required ─────────────────────────────────────────────────────────────────

# The Supabase project URL. Supabase → Project Settings → API.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The SERVICE ROLE key, never the anon or publishable key.
#
#   Supabase → Project Settings → API → service_role
#
# This key bypasses RLS. It grants full access to every row in the project,
# including other tenants' billing data, so it must exist only on the VPS.
# Generate it for this worker specifically and rotate it if the host is ever
# suspected of compromise.
SUPABASE_SERVICE_ROLE_KEY=PASTE_SERVICE_ROLE_KEY_HERE

# Encrypts and decrypts router passwords.
#
# MUST be byte-identical to the value set on the Supabase Edge Functions
# (`supabase secrets set ROUTER_CREDENTIALS_KEY=...`). If they differ, the
# worker cannot read any router credential and every job fails to decrypt.
#
# Generate with:  openssl rand -base64 32
ROUTER_CREDENTIALS_KEY=PASTE_ROUTER_CREDENTIALS_KEY_HERE

# Identifies this worker in the platform. It appears in the Network Status
# dashboard and is what `locked_by` records on a claimed job.
#
# Use one stable name per host: "vps-frankfurt-1". A name that changes on every
# restart would make job history unreadable.
WORKER_NAME=vps-region-1

# ── Optional: identity shown in the dashboard ───────────────────────────────

# Region label, e.g. "eu-central". Display only.
# WORKER_REGION=eu-central

# The VPS's public egress address. Informational: it helps an operator confirm
# which machine is failing a rate-limited provider call.
# WORKER_PUBLIC_IP=203.0.113.10

# ── Optional: WireGuard, for routers behind CGNAT ───────────────────────────
#
# A router inside CGNAT has no inbound route from the internet, so its RouterOS
# API cannot be reached. A WireGuard tunnel from the router to this VPS gives the
# worker a persistent private path. The router side is configured by
# `router-provision`; these values identify the server end.
#
# Generate the key pair once with:
#   wg genkey | tee privatekey | wg pubkey > publickey
#
# WORKER_WG_ADDRESS=10.77.0.1/24
# WORKER_WG_PUBLIC_KEY=PASTE_SERVER_PUBLIC_KEY

# ── Optional: tuning ─────────────────────────────────────────────────────────

# How often each managed router is polled. Smaller means faster detection of a
# down router and more load on every router.
# WORKER_HEARTBEAT_SECS=30

# Health endpoint port. Bound to 127.0.0.1 only; never expose it publicly.
# WORKER_HEALTH_PORT=9090

# Require a trusted TLS chain when connecting to a router over HTTPS.
#
# Leave false for routers using the self-signed certificate RouterOS generates
# out of the box. Set true only when every managed router has a real
# certificate, or strict mode will refuse to connect.
# NETISP_TLS_STRICT=false
